<Window x:Class="TurboCore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TurboCore" Height="620" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="TURBOCORE" Style="{StaticResource TitleText}" Foreground="{StaticResource AccentBrush}" FontSize="24"/>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,3" Margin="12,4,0,0">
                <TextBlock x:Name="PlanBadge" Text="Plano: —" Foreground="{StaticResource Accent2Brush}" FontSize="11" FontWeight="Bold"/>
            </Border>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Otimização de PC e Boost de FPS" Style="{StaticResource SubText}" Margin="0,4,0,20"/>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Otimização de PC">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Limpeza e Sistema" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkCleanTemp" Content="Limpar ficheiros temporários" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="ChkFlushDns" Content="Limpar cache de DNS" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="ChkStartup" Content="Desativar programas de arranque desnecessários" IsChecked="False" Margin="0,4"/>
                                <CheckBox x:Name="ChkHighPower" Content="Ativar plano de energia Alto Desempenho" IsChecked="True" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Executar Otimização de PC" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Click="RunPcOptimization_Click" x:Name="RunPcButton"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Boost de FPS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Ajustes para Jogos" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkBoostForeground" Content="Priorizar processo do jogo em primeiro plano" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="ChkUltimatePower" Content="Ativar plano de energia Desempenho Máximo" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="ChkVisualEffects" Content="Reduzir efeitos visuais do Windows" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="ChkGameBar" Content="Desativar Xbox Game Bar / gravação em fundo" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="ChkNetwork" Content="Otimizar rede (desativar Nagle, reduz latência)" IsChecked="False" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Executar Boost de FPS" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Click="RunFpsBoost_Click" x:Name="RunFpsButton"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,16,0,0" MaxHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LogPanel">
                    <TextBlock Text="Os resultados de cada ação aparecem aqui." Style="{StaticResource SubText}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
